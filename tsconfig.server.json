{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@app-types/*": ["frontend/saalik-mobile/src/types/*"],
      "@react-native-async-storage/async-storage": [
        "frontend/saalik-mobile/node_modules/@react-native-async-storage/async-storage"
      ]
    },
    "types": ["node", "jest"],
    "declaration": false
  },
  "include": ["backend/src/heritage/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "frontend", "dist", "backend/src/routes", "backend/src/services/ai.ts"]
}
