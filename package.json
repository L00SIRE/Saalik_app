{
  "name": "saalik-app-workspace",
  "private": true,
  "description": "Saalik Nepal heritage workspace: seed corpus, Hybrid Geo-Visual API, and shared tooling",
  "scripts": {
    "seed:compile": "ts-node data/nepal_heritage_seed/validate_and_compile.ts",
    "seed:typecheck": "tsc --noEmit -p tsconfig.json",
    "server:typecheck": "tsc --noEmit -p tsconfig.server.json",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "heritage:dev": "ts-node src/server/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  }
}
