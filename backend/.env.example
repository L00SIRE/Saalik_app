# ─────────────────────────────────────────────────────────────────────────────
# Saalik Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
# Dev default: local SQLite (no setup, zero cost).
# Prod: switch to Postgres. Free options:
#   - Supabase (free tier: 500MB Postgres, 2 active projects)         https://supabase.com/pricing
#   - Neon       (free tier: 0.5GB storage, autoscaling, branches)    https://neon.tech/pricing
#   - Railway    (free trial $5 credit, then ~$5/mo Postgres)         https://railway.com/pricing
# Postgres example:
#   DATABASE_URL="postgresql://user:pass@host:5432/saalik?schema=public"
DATABASE_URL="file:./dev.db"

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Generate strong random secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ROTATE THESE BEFORE GOING TO PROD. Different values for access vs refresh.
JWT_SECRET=replace_me_with_a_64_byte_hex_string
REFRESH_TOKEN_SECRET=replace_me_with_a_DIFFERENT_64_byte_hex_string

# ─── AI / Gemini ─────────────────────────────────────────────────────────────
# Free tier: Google AI Studio (Gemini API)
#   - Free quota: 15 RPM, 1M TPM, 1.5K RPD on gemini-2.0-flash
#   - Get key:    https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# ─── Optional / Future ───────────────────────────────────────────────────────
# Add as features land. All free-tier friendly.
#
# Cloudflare R2 (object storage, no egress fees, 10 GB free):
#   R2_ACCOUNT_ID=
#   R2_ACCESS_KEY_ID=
#   R2_SECRET_ACCESS_KEY=
#   R2_BUCKET=saalik-media
#
# Resend (email, 3K/mo free, much simpler than SendGrid):
#   RESEND_API_KEY=
#
# Expo push notifications (free, no key needed for FCM/APNs proxy):
#   EXPO_ACCESS_TOKEN=     # only required for server-side delivery receipts
#
# Sentry (error tracking, 5K events/mo free):
#   SENTRY_DSN=
