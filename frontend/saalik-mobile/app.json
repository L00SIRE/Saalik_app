{
  "expo": {
    "name": "saalik-mobile",
    "slug": "saalik-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.saalik-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Saalik records a voice note when you choose to attach one to a field photo."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saalik uses your location to find the monuments around you and to tag field photos.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Saalik uses the camera to recognise monuments and to capture reference photos.",
          "microphonePermission": "Saalik records a voice note when you choose to attach one to a field photo.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
