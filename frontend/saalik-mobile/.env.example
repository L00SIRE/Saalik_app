# ─────────────────────────────────────────────────────────────────────────────
# Saalik Mobile — Environment Variables
# Copy this file to `.env` and adjust for your machine.
# Vars MUST start with `EXPO_PUBLIC_` to be embedded in the JS bundle.
# `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API ─────────────────────────────────────────────────────────────────────
# iOS Simulator: localhost works
# Android Emulator: use 10.0.2.2 instead of localhost
# Physical device: use your dev machine's LAN IP (e.g. http://192.168.1.42:4000/api)
# Production:  https://api.saalik.app/api  (or whatever you ship)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ─── Mock mode ───────────────────────────────────────────────────────────────
# Set to "true" to bypass the backend entirely and use in-memory fixtures.
# Useful for UI work, demos, and CI screenshots without a server.
# Default in code is currently `true` — flip to `false` once auth is wired e2e.
EXPO_PUBLIC_USE_MOCK=true

# ─── Future (free-tier services) ─────────────────────────────────────────────
# Sentry (error tracking, 5K events/mo free):
#   EXPO_PUBLIC_SENTRY_DSN=
# PostHog (product analytics, 1M events/mo free):
#   EXPO_PUBLIC_POSTHOG_KEY=
#   EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Maps (when wiring real maps; $200/mo free credit covers ~28K loads):
#   EXPO_PUBLIC_GOOGLE_MAPS_KEY=
