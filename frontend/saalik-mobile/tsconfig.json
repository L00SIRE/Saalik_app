{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@theme": [
        "src/theme/index.ts"
      ],
      "@theme/*": [
        "src/theme/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@logic/*": [
        "src/logic/*"
      ],
      "@integration": [
        "src/integration/index.ts"
      ],
      "@integration/*": [
        "src/integration/*"
      ],
      "@app-types/*": [
        "src/types/*"
      ],
      "@context/*": [
        "src/context/*"
      ]
    }
  }
}